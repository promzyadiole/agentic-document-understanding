# --- Backend environment (copy to backend/.env) ---

# LLMs (everything runs on OpenAI: extraction, classification, RAG,
# embeddings, lead scoring, and proposal generation)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Vector store
PINECONE_API_KEY=...
INDEX_NAME=agentic-document-understanding

# Lead research
TAVILY_API_KEY=tvly-...

# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AGENTIC DOCUMENT UNDERSTANDING
LANGSMITH_TRACING=true

# Deployment / networking
APP_ENV=development
# Comma-separated allowed frontend origins (no trailing slash)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of THIS backend (used to build asset URLs)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Storage (anchored to the backend root automatically)
UPLOAD_DIR=app/data/uploads
PROCESSED_DIR=app/data/processed
GRAPH_OUTPUT_DIR=app/data/graph
